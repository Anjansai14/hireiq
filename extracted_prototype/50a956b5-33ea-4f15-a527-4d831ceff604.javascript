let S; try{S=JSON.parse(localStorage.getItem(KEY))}catch(e){} if(!S||S.v!==1) S=seed();
const subs=new Set(); const toasts=[];
let raf=null;
function emit(){ if(raf) return; raf=true; setTimeout(()=>{raf=null;subs.forEach(f=>{try{f()}catch(e){console.error(e)}})},0); }
function save(){ try{localStorage.setItem(KEY,JSON.stringify(S))}catch(e){} }

const n=x=>{if(x==null||isNaN(x))return'—';const a=Math.abs(x);if(a>=1e7)return(x/1e6).toFixed(1).replace(/\.0$/,'')+'M';if(a>=1e6)return(x/1e6).toFixed(2).replace(/0$/,'')+'M';if(a>=1e4)return Math.round(x/1e3)+'K';if(a>=1e3)return(x/1e3).toFixed(1).replace(/\.0$/,'')+'K';return String(Math.round(x))};
const inr=x=>x==null?'—':'₹'+Math.round(x).toLocaleString('en-IN');
const inrL=x=>{if(x==null)return'—';if(x>=1e7)return'₹'+(x/1e7).toFixed(2)+' Cr';if(x>=1e5)return'₹'+(x/1e5).toFixed(1).replace(/\.0$/,'')+'L';return inr(x)};
const MO=['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];
const d=s=>{if(!s)return'—';const [y,m,dd]=s.slice(0,10).split('-');if(!m)return s;return(+dd)+' '+MO[+m-1]+' '+y};
const ds=s=>{if(!s)return'—';const [y,m,dd]=s.slice(0,10).split('-');if(!m)return s;return(+dd)+' '+MO[+m-1]};
const dt=s=>{if(!s)return'—';return ds(s)+(s.length>10?', '+s.slice(11,16):'')};
const TONES={success:['#E6F5EC','#14582F'],warning:['#FDF3DC','#7A4F0F'],danger:['#FCE9E6','#8A241A'],info:['#E6EFFA','#183F6E'],neutral:['#EEF3F2','#43565A'],teal:['#F0FAF7','#0F5C54']};
const TMAP={Live:'success',Delivered:'success',Enriched:'success',Pass:'success',Ahead:'success',Approved:'success',Connected:'success',Active:'success',Verified:'success','On track':'success',Observed:'success',Accepted:'success',Cleared:'success',Confirmed:'info',Ready:'success',Extracted:'success',Imported:'success',Generated:'success',Stored:'neutral',Positive:'success',
 Approached:'info',Negotiating:'warning','Content in review':'info',Fetching:'info',Queued:'neutral',Inferred:'info','In review':'info',Predicted:'info','Strongly Inferred':'info',Running:'info',New:'info',Merge:'neutral',
 Warning:'warning',Partial:'warning',Expiring:'warning',Idle:'warning',Illustrative:'warning',Stale:'warning','Needs attention':'warning','Under review':'warning',Unconfirmed:'warning',Neutral:'neutral',Medium:'warning',Open:'info',
 Behind:'danger',Fail:'danger',Failed:'danger',Declined:'danger','Backed out':'danger',Blocked:'danger',Refused:'danger',Negative:'danger',Missing:'danger',Error:'danger',Expired:'danger',Low:'danger',High:'success',
 Draft:'neutral',Closed:'neutral',Identified:'neutral',Unsupported:'neutral','Phase 2':'neutral',Unknown:'neutral','Not checked':'neutral',Dismissed:'neutral',Entered:'neutral',Edited:'neutral'};
const tone=s=>{const t=TONES[TMAP[s]||'neutral'];return{bg:t[0],fg:t[1]}};

const sumPosts=(ccs)=>{let v=0,l=0,c=0,sh=0,sv=0,shA=false,pos=0,neu=0,neg=0,cw=0,intent=0,posts=0;ccs.forEach(x=>x.posts.forEach(p=>{v+=p.views;l+=p.likes;c+=p.comments;if(p.shares!=null){sh+=p.shares;shA=true}if(p.saves!=null)sv+=p.saves;if(p.sent){pos+=p.sent[0]*p.comments;neu+=p.sent[1]*p.comments;neg+=p.sent[2]*p.comments;cw+=p.comments}intent+=p.intent||0;posts++}));
 return{views:v,likes:l,comments:c,shares:sh,saves:sv,sharesAvail:shA,eng:l+c+sh,er:v?((l+c+sh)/v*100):0,pos:cw?Math.round(pos/cw):0,neu:cw?Math.round(neu/cw):0,neg:cw?Math.round(neg/cw):0,intent,posts}};
const dealTotal=x=>x.deal?x.deal.rate*x.deal.posts:0;
function campStats(c){const s=sumPosts(c.ccs);let committed=0,spent=0;c.ccs.forEach(x=>{if(COMMITTED.includes(x.status)){committed+=dealTotal(x);spent+=x.deal.rate*Math.min(x.posts.length,x.deal.posts)}});(c.boosts||[]).forEach(b=>{committed+=b;spent+=b});s.committed=committed;s.spent=spent;s.remaining=c.budget-committed;s.wi=s.intent+s.shares*0.2+s.likes*0.02;s.cpi=s.wi?spent/s.wi:0;s.live=c.ccs.filter(x=>x.status==='Live'||x.status==='Delivered').length;s.creators=c.ccs.length;return s}
function ccStats(x){const s=sumPosts([x]);s.total=dealTotal(x);s.spent=x.deal&&COMMITTED.includes(x.status)?x.deal.rate*Math.min(x.posts.length,x.deal.posts):0;s.wi=s.intent+s.shares*0.2+s.likes*0.02;s.cpi=s.wi?s.spent/s.wi:0;return s}
function series(c){const days=Math.max(1,Math.min(daysBetween(c.start,c.status==='Closed'?c.end:TODAY),daysBetween(c.start,c.end)));const total=daysBetween(c.start,c.end);const curve=a=>a<0?0:1-Math.exp(-a/2.2);const pts=[];for(let i=0;i<=days;i++){const day=addDays(c.start,i);let v=0;c.ccs.forEach(x=>x.posts.forEach(p=>{const age=daysBetween(p.date,day);const now=Math.max(0.5,daysBetween(p.date,c.status==='Closed'?c.end:TODAY));v+=p.views*Math.min(1,curve(age)/curve(now))}));pts.push({day,v})}
 const band=[];for(let i=0;i<=total;i++){const f=Math.pow(i/total,0.7);band.push({lo:c.pred.views[0]*f,hi:c.pred.views[1]*f})}return{pts,band,total}}
function rank(opts){const C=S.creators;const w={Awareness:[.5,.2,.2,.1],Engagement:[.3,.4,.2,.1],Intent:[.25,.25,.35,.15],Bookings:[.2,.2,.4,.2]}[opts.objective]||[.3,.3,.3,.1];const tierMed={Micro:5.5,Mid:5,Macro:4.5,Mega:2.5,Nano:7};const res=[],blocked=[];
 C.forEach(c=>{if(opts.channels&&!opts.channels.includes(c.platform))return;const bo=c.history.slice(-3).filter(h=>h.status==='Backed out').length;let gate=null;if(bo>=2)gate={rule:'Reliability gate',reason:'Backed out on 2 of the last 3 campaigns'};else if(c.flags.includes('paidTie'))gate={rule:'RR-Z05',reason:c.flagNote||'Undisclosed paid tie within 18 months'};else if(c.verif==='Contested')gate={rule:'Verification',reason:'Verification contested'};if(gate){blocked.push(Object.assign({c},gate));return}
  const mk=(opts.markets||MK).reduce((a,m)=>a+(c.markets[m]||0),0)/100;const lg=(opts.languages||['Telugu']).reduce((a,l)=>a+(c.langs[l]||0),0)/100;const qr=c.followers*mk*Math.max(lg,0.02);const q=Math.min(1.6,c.er/(tierMed[c.tier]||5));const topics=opts.topics||['Action','Period drama','Folk myth'];const fit=Math.max(0.05,topics.reduce((a,t)=>Math.max(a,c.topics[t]||0),0));const rel=c.history.length?c.history.filter(h=>h.status==='Delivered').length/c.history.length:0.7;const score=Math.pow(qr/1e5+0.1,w[0])*Math.pow(q,w[1])*Math.pow(fit,w[2])*Math.pow(rel+0.1,w[3]);
  const flags=[];if(daysBetween(c.updated,TODAY)>90)flags.push('Profile not refreshed in 90 days');if(daysBetween(c.lastPost,TODAY)>60)flags.push('No post in 60 days');
  const topM=Object.entries(c.markets).sort((a,b)=>b[1]-a[1])[0];const topL=Object.entries(c.langs).sort((a,b)=>b[1]-a[1])[0];
  res.push({c,qr,q,fit,rel,score,flags,fee:c.rate,topM,topL,why:'Reaches '+topM[0]+' ('+topM[1]+'% of audience) in '+topL[0]+'; median '+n(c.mv)+' views on recent '+c.formats[0].toLowerCase()+'; engagement '+c.er+'% vs tier median '+(tierMed[c.tier]||5)+'%.',where:c.platform+' · '+c.formats.join(', '),what:c.content[0]+' in '+c.tone.toLowerCase()+' tone',past:c.history.length?c.history.filter(h=>h.status==='Delivered').length+' delivered of '+c.history.length+(c.history.some(h=>h.rating)?' · avg rating '+(c.history.filter(h=>h.rating).reduce((a,h)=>a+h.rating,0)/c.history.filter(h=>h.rating).length).toFixed(1):''):'No history with this team'})});
 res.sort((a,b)=>b.score-a.score);const max=res[0]?res[0].score:1;res.forEach(r=>{r.pct=Math.round(r.score/max*100);r.fitPct=Math.round(r.fit*100)});return{list:res,blocked}}

window.IQ={TODAY,STATUSES,COMMITTED,MK,uid,addDays,daysBetween,n,inr,inrL,d,ds,dt,tone,campStats,ccStats,series,rank,sumPosts,dealTotal,
 get s(){return S},get toasts(){return toasts},
 set(fn){fn(S);save();emit()},
 sub(f){subs.add(f);return()=>subs.delete(f)},
 go(name,p){S.route=Object.assign({name},p||{});save();emit();setTimeout(()=>{const m=document.querySelector('[data-iq-main]');if(m)m.scrollTop=0},0)},
 toast(text,kind){const id=uid('t');toasts.push({id,text,kind:kind||'ok'});emit();setTimeout(()=>{const i=toasts.findIndex(t=>t.id===id);if(i>=0){toasts.splice(i,1);emit()}},kind==='error'?7000:4000)},
 dismissToast(id){const i=toasts.findIndex(t=>t.id===id);if(i>=0){toasts.splice(i,1);emit()}},
 reset(){S=seed();S.user={name:'Anika Rao',email:'anika.rao@peopletech.com',role:'Manager',title:'Campaign manager'};S.module='screen';S.route={name:'dashboard'};save();emit()},
 film(id){return S.films.find(f=>f.id===(id||S.filmId))},
 campSummary(c){ if(!c||c.status==='Draft') return ''; if(c.summary) return c.summary; const film=S.films.find(f=>f.id===c.filmId)||{title:''};
  return c.asset==='Song'
   ? 'Conversation around '+film.title+' this week is led by the "'+c.name.replace(/ song push$/i,'')+'" hook step, with Telugu and Kannada creators posting their own versions on Instagram Reels. Fans are praising the folk percussion and asking for a full lyrical video with English subtitles. Several comments compare the choreography to earlier hit songs, mostly in a positive tone. A smaller thread questions whether the song fits the film\'s period setting. Mentions of the lead pair\'s chemistry are rising, especially among 18–24 viewers. Overall sentiment is positive and engagement is still climbing day over day.'
   : 'People are talking most about the scale of '+film.title+'\'s action sequences and the period look shown in the '+c.asset.toLowerCase()+'. Viewers in Andhra Pradesh and Telangana are sharing reaction videos and freeze-frame breakdowns of the climax shots. Hindi-belt audiences are asking about the dubbed release date and whether the dub will release alongside the original. The background score is getting strong praise and is being reused in fan edits. Some comments compare the visual style to recent pan-India releases, with mixed opinions on originality. Overall sentiment is positive, with curiosity about the story still the most common question.'; },
 filmSummary(film){ const cs=S.campaigns.filter(c=>c.filmId===film.id&&c.status!=='Draft'); if(!cs.length) return '';
  const hasSong=cs.some(c=>c.asset==='Song'), hasTrailer=cs.some(c=>c.asset!=='Song');
  return 'Across '+cs.length+' campaign'+(cs.length>1?'s':'')+', conversation about '+film.title+' is broadly positive and still growing. '+(hasTrailer?'The action scale, period look and background score are the most discussed parts of the trailer, with reaction videos and fan edits spreading in Andhra Pradesh and Telangana. ':'')+(hasSong?'The song\'s hook step has become its own trend on Instagram Reels, and fans are asking for a lyrical video with subtitles. ':'')+'Hindi and Kannada audiences keep asking when the dubbed versions release. A smaller share of comments questions originality or whether some creator posts feel too much like ads. Curiosity about the story is the most common question heading into release.'; },
 camp(id){return S.campaigns.find(c=>c.id===id)},
 creator(id){return S.creators.find(c=>c.id===id)},
 paidOf(c){if(c.paid)return c.paid;const n=parseInt(String(c.id).replace(/\D/g,''))||0;return (c.type||'').match(/fan|community/i)||n%4===3?'Unpaid':'Paid'},
 accOf(c){if(c.account)return c.account;const n=parseInt(String(c.id).replace(/\D/g,''))||0;return n%5===2||(c.type||'').match(/studio|official|in-house/i)?'Internal':'External'},
 ccOf(campId,ccId){const c=S.campaigns.find(k=>k.id===campId);return c&&c.ccs.find(x=>x.id===ccId)},
 readiness(f){const req=f.brief.filter(b=>b.tier==='req');const ok=req.filter(b=>b.value&&b.status==='Confirmed');const strong=f.brief.filter(b=>b.tier==='strong');return{req:req.length,ok:ok.length,missing:req.filter(b=>!b.value||b.status!=='Confirmed'),strongOk:strong.filter(b=>b.value&&b.status==='Confirmed').length,strong:strong.length,pct:Math.round(ok.length/req.length*100),refused:f.flags.some(x=>x.status==='Refused')}},
 later(ms,fn){return setTimeout(fn,ms)}
};
})();
