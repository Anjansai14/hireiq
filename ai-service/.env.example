# Claude API key. Leave empty to run every agent in deterministic fallback mode.
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5-5
LLM_MAX_TOKENS=2000
# Shared secret the Node backend sends in X-Service-Key
AI_SERVICE_KEY=change-me
# Optional official-API keys used by Agent A3 enrichment
YOUTUBE_API_KEY=
META_GRAPH_TOKEN=
