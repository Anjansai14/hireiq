 "governance_rules": [
  {
   "code": "RR-H01",
   "title": "No individual targeting",
   "description": "Hire IQ only reaches aggregate cohorts and never targets or isolates an individual candidate. Requests are refused and logged; individuals use the standard enrolment channel.",
   "enforcement": "Refuse",
   "owner_role": "Fairness reviewer"
  },
  {
   "code": "RR-H02",
   "title": "No protected-attribute targeting",
   "description": "A cohort or eligibility rule cannot be defined by or exclude caste, religion, gender, disability or another protected attribute. Refused, logged and escalated to the fairness reviewer.",
   "enforcement": "Refuse",
   "owner_role": "Fairness reviewer"
  },
  {
   "code": "RR-H03",
   "title": "Outcome claims need Observed evidence",
   "description": "Placement, salary or job claims are held as claims awaiting evidence. No narrative or content may use them until Observed evidence is attached.",
   "enforcement": "Hold",
   "owner_role": "Manager"
  },
  {
   "code": "RR-H04",
   "title": "Disclosure on paid items",
   "description": "Every paid content item must carry the platform disclosure tag (#ad). Approval is blocked otherwise.",
   "enforcement": "Block",
   "owner_role": "Manager"
  },
  {
   "code": "RR-H05",
   "title": "Message and programme mismatch",
   "description": "When click-through is healthy but enrolment rate per registration is below the floor, treat it as a message/programme mismatch, not channel failure.",
   "enforcement": "Warn",
   "owner_role": "Manager"
  },
  {
   "code": "RR-H06",
   "title": "Institutional consent",
   "description": "Any college, ITI or placement cell needs a consent record before it can move to Confirmed.",
   "enforcement": "Block",
   "owner_role": "Manager"
  },
  {
   "code": "RR-H07",
   "title": "Lift claims need a holdout",
   "description": "An effectiveness or lift claim needs a holdout cohort or matched district; not available in v1, so reports show attributed enrolments only.",
   "enforcement": "Warn",
   "owner_role": "Admin"
  },
  {
   "code": "RM-05",
   "title": "District normalisation",
   "description": "Districts are resolved to standard names before cohort sizing.",
   "enforcement": "Info",
   "owner_role": null
  },
  {
   "code": "RM-09",
   "title": "Enrolment lag model",
   "description": "Late enrolment records can make a healthy campaign look Behind; checkpoints apply a lag curve. Priors are recalibrated after each batch closes.",
   "enforcement": "Info",
   "owner_role": null
  }
 ],
