# =====================================================================
# HireIQ — Unified Environment Configuration Template
# 
# Instructions:
# 1. Copy this file to .env at the root of the project:
#      cp .env.example .env
# 2. Fill in or customize any values needed for your environment.
# 3. Docker Compose and standalone services both read this single file.
# =====================================================================

# ---------------------------------------------------------------------
# 1. AI Service Configuration (Python FastAPI · Port 8001)
# ---------------------------------------------------------------------
# Anthropic Claude API Key.
# Leave blank to run all 12 agents in deterministic rule-based fallback mode.
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5-5
LLM_MAX_TOKENS=2000

# Shared secret token used between Express API and FastAPI AI service
AI_SERVICE_KEY=generate_a_secure_random_ai_service_token_here
AI_SERVICE_URL=http://localhost:8001

# ---------------------------------------------------------------------
# 2. Security & Encryption (Express API · Port 4000)
# ---------------------------------------------------------------------
# High-entropy secret key used to sign JWT session tokens (at least 64 chars)
JWT_SECRET=generate_a_strong_random_jwt_secret_at_least_64_characters_here

# 32-byte hex key (64 hex characters) used for AES-256-GCM token encryption at rest
TOKEN_ENC_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# ---------------------------------------------------------------------
# 3. Database & Network Configuration
# ---------------------------------------------------------------------
# When running via Docker Compose, Docker handles these automatically.
# Use these values when running services locally (bare-metal without Docker).
PORT=4000
DB_HOST=localhost
DB_PORT=3306
DB_USER=hireiq
DB_PASSWORD=hireiq
DB_NAME=hireiq
CORS_ORIGIN=http://localhost:5173
UPLOAD_DIR=./uploads
ENABLE_JOBS=true

# ---------------------------------------------------------------------
# 4. Optional Third-Party Social API Integrations
# ---------------------------------------------------------------------
# Used by Agent A03 and the scheduler for live YouTube / Meta channel telemetry.
# If left blank, synthetic telemetry heuristics are used automatically.
YOUTUBE_API_KEY=
META_GRAPH_TOKEN=
