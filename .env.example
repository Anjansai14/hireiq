# Environment Configuration Template for HireIQ
# Copy to .env and replace placeholders with secure random secrets before deploying.

# AI Service Settings
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5-5
AI_SERVICE_KEY=generate_a_secure_random_ai_service_token_here

# Security & Encryption (Generate high-entropy strings for production)
JWT_SECRET=generate_a_strong_random_jwt_secret_at_least_64_characters_here
TOKEN_ENC_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Third-party Integrations (Optional)
YOUTUBE_API_KEY=

